+def test_columnar_format_round_trips_all_original_values():
+    raw = messages()
+    before = deepcopy(raw)
+    options = dict(context_window=200000, max_input_tokens=180000)
+    grouped, grouped_stats = pack_context(
+        raw, [], "scissors", ContextBudget(**options, evidence_format="grouped"))
+    columnar, columnar_stats = pack_context(
+        raw, [], "scissors", ContextBudget(**options, evidence_format="columnar"))
+    assert raw == before
+    assert grouped_stats["selected_sources"] == columnar_stats["selected_sources"]
+    grouped_document = next(iter(docs(grouped)[1].values()))
+    columnar_document = next(iter(docs(columnar)[1].values()))
+    for field in ("speech_transcript", "events", "characters", "entities"):
+        value = columnar_document[field]
+        if isinstance(value, dict) and "columns" in value:
+            columns = value["columns"]
+            decoded = [[row[0], dict(zip(columns[1:], row[1:]))] for row in value["rows"]]
+        else:
+            decoded = value
+        assert decoded == grouped_document[field]
+    assert columnar_document["description"] == grouped_document["description"]
+    assert request_units(columnar, []) < request_units(grouped, [])
+
+
+def test_columnar_keeps_heterogeneous_entries_in_grouped_format():
+    document = {"node_id": "n", "passages": [
+        {"field": "speech_transcript", "index": 0, "value": {"text": "a", "speaker": "X"}},
+        {"field": "speech_transcript", "index": 1, "value": {"text": "b"}},
+    ]}
+    assert model_document(document, "columnar")["speech_transcript"] == [
+        [0, {"text": "a", "speaker": "X"}], [1, {"text": "b"}]]
+
+
