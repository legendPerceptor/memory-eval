+def _incremental_budget_for_call(budget: ContextBudget, prior_visible: bool) -> ContextBudget:
+    configured = os.environ.get("OGMEM_M3_LATER_INCREMENTAL_TOKENS")
+    if not configured or not budget.incremental_delivery or not prior_visible:
+        return budget
+    try:
+        later_tokens = int(configured)
+    except ValueError as exc:
+        raise ValueError("OGMEM_M3_LATER_INCREMENTAL_TOKENS must be a positive integer") from exc
+    if later_tokens <= 0 or later_tokens > budget.incremental_tokens:
+        raise ValueError("OGMEM_M3_LATER_INCREMENTAL_TOKENS must be positive and no greater "
+                         "than the initial incremental budget")
+    return replace(budget, incremental_tokens=later_tokens)
+
