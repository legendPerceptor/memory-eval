diff --git a/tests/unit/m3/test_reasoning_model_config.py b/tests/unit/m3/test_reasoning_model_config.py
new file mode 100644
index 00000000..7e819c28
--- /dev/null
+++ b/tests/unit/m3/test_reasoning_model_config.py
@@ -0,0 +1,67 @@
+"""Reasoning settings must reach every M3 model role without changing defaults."""
+from unittest.mock import Mock, patch
+
+import pytest
+import yaml
+
+from m3.config import load_m3_runtime_config
+from m3.llm_factory import build_m3_llm
+
+
+def config_file(tmp_path, data):
+    path = tmp_path / "config.yaml"
+    path.write_text(yaml.safe_dump(data))
+    return str(path)
+
+
+@pytest.mark.parametrize("provider", ["openai", "minimax"])
+@pytest.mark.parametrize("role", ["episodic_llm", "qa_llm", "judge_llm"])
+def test_factory_forwards_reasoning_parameters(tmp_path, monkeypatch, provider, role):
+    ctor = Mock()
+    monkeypatch.setattr("providers.llm.get_minimax_llm", lambda: ctor)
+    monkeypatch.setattr("providers.llm.get_openai_llm", lambda: (ctor, None))
+    path = config_file(tmp_path, {
+        "llm": {"provider": provider, "api_key": "test-only", "model": "MiniMax-M3.1-Flash",
+                "is_reasoning_model": True, "reasoning_effort": "high",
+                "extra_body": {"thinking": {"type": "adaptive"}}},
+        "m3": {role: {"reasoning_effort": "max", "max_tokens": 8192}},
+    })
+    build_m3_llm(config_path=path, config_role=role)
+    kw = ctor.call_args.kwargs
+    assert kw["reasoning_effort"] == "max"
+    assert kw["is_reasoning_model"] is True
+    assert kw["extra_body"] == {"thinking": {"type": "adaptive"}}
+    assert kw["max_tokens"] == 8192
+
+
+@pytest.mark.parametrize("key,value", [
+    ("is_reasoning_model", "false"), ("is_reasoning_model", 1),
+    ("reasoning_effort", 3), ("extra_body", "thinking"), ("extra_body", []),
+])
+def test_invalid_reasoning_config_rejected(tmp_path, key, value):
+    with pytest.raises(ValueError, match=key):
+        load_m3_runtime_config(config_file(tmp_path, {"llm": {key: value}}))
+
+
+def test_legacy_defaults_unchanged(tmp_path):
+    runtime = load_m3_runtime_config(config_file(tmp_path, {}))
+    for role in ("episodic_llm", "qa_llm", "judge_llm"):
+        config = getattr(runtime, role)
+        assert config.reasoning_effort is None
+        assert config.is_reasoning_model is None
+        assert config.extra_body is None
+
+
+def test_minimax_uses_completion_budget_and_adaptive_body(monkeypatch):
+    from providers.llm.minimax_llm import MiniMaxLLM
+    monkeypatch.delenv("OGMEM_MINIMAX_MODEL", raising=False)
+    with patch("providers.llm.openai_llm.OpenAI"):
+        llm = MiniMaxLLM(
+            api_key="test-only", model="MiniMax-M3.1-Flash", max_tokens=8192,
+            is_reasoning_model=True, reasoning_effort="max",
+            extra_body={"thinking": {"type": "adaptive"}},
+        )
+    assert llm._completion_parameters(0.2) == {
+        "max_completion_tokens": 8192, "reasoning_effort": "max",
+        "extra_body": {"thinking": {"type": "adaptive"}},
+    }
diff --git a/tests/unit/m3/test_episodic_workers.py b/tests/unit/m3/test_episodic_workers.py
new file mode 100644
index 00000000..14ed998a
--- /dev/null
+++ b/tests/unit/m3/test_episodic_workers.py
@@ -0,0 +1,93 @@
+import json
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from m3 import episodic_memory as module
+
+
+def jobs(count):
+    return [("video", i, {"video_raw_node": SimpleNamespace(node_id=str(i)), "force": bool(i % 2)})
+            for i in range(count)]
+
+
+def test_parallel_jobs_are_bounded_ordered_and_keep_failures(monkeypatch):
+    active = peak = 0
+    lock = threading.Lock()
+    flags = {}
+
+    def generate(**kw):
+        nonlocal active, peak
+        i = int(kw["video_raw_node"].node_id)
+        with lock:
+            active += 1
+            peak = max(peak, active)
+            flags[i] = kw["force"]
+        try:
+            time.sleep(0.03 if i == 0 else 0.01)
+            if i == 2:
+                raise RuntimeError("permanent clip failure")
+            return {"clip_id": i, "resumed": False}, i
+        finally:
+            with lock:
+                active -= 1
+
+    monkeypatch.setattr(module, "_generate_with_retry", generate)
+    result = list(module._parallel_generations(jobs(8), workers=3))
+    assert 1 < peak <= 3
+    assert [r[1] for r in result] == list(range(8))
+    assert str(result[2][4]) == "permanent clip failure"
+    assert all(r[4] is None for i, r in enumerate(result) if i != 2)
+    assert result[7][3] == 7
+    assert flags == {i: bool(i % 2) for i in range(8)}
+
+
+def test_parallel_duplicate_nodes_rejected_before_generation(monkeypatch):
+    monkeypatch.setattr(module, "_generate_with_retry", lambda **kw: pytest.fail("must not run"))
+    duplicate = jobs(1) * 2
+    with pytest.raises(ValueError, match="distinct"):
+        list(module._parallel_generations(duplicate, workers=2))
+
+
+@pytest.mark.parametrize("workers", [0, -1, 5])
+def test_worker_limit(workers):
+    with pytest.raises(SystemExit):
+        module.parse_args(["--video-records-manifest", "v", "--frames-manifest", "f",
+                           "--workers", str(workers)])
+
+
+@pytest.mark.parametrize("workers", [1, 3])
+def test_run_counters_and_failure_manifest(tmp_path, monkeypatch, workers):
+    video_manifest = tmp_path / "data.jsonl"
+    frames_manifest = tmp_path / "frames.jsonl"
+    video_manifest.write_text(json.dumps({"id": "video", "raw_nodes": [
+        {"clip_id": i, "raw_node_id": str(i)} for i in range(4)]}) + "\n")
+    frames_manifest.write_text("\n".join(json.dumps(
+        {"video_id": "video", "clip_id": i, "child_node_ids": [f"frame{i}"]})
+        for i in range(4)) + "\n")
+    monkeypatch.setattr(module, "_build_llm", lambda args: object())
+    monkeypatch.setattr(module, "_index_asr_segments", lambda *args: {})
+    graph = SimpleNamespace(get_raw_node=lambda node_id, ctx: SimpleNamespace(node_id=node_id))
+
+    def generate(**kw):
+        i = int(kw["video_raw_node"].node_id)
+        if i == 1:
+            raise RuntimeError("failed")
+        return {"description": "ok", "resumed": i == 2, "clip_id": i}, 0
+
+    monkeypatch.setattr(module, "_generate_with_retry", generate)
+    output = tmp_path / "episodic_memory.jsonl"
+    args = module.parse_args([
+        "--video-records-manifest", str(video_manifest), "--frames-manifest", str(frames_manifest),
+        "--output-jsonl", str(output), "--workers", str(workers)])
+    assert module.run(args, graph=graph, op_service=object()) == 2
+    summary = json.loads(output.with_suffix(".summary.json").read_text())
+    assert summary["expected_clips"] == 4
+    assert summary["completed_clips"] == 3
+    assert summary["generated_clips"] == 2
+    assert summary["resumed_clips"] == 1
+    assert summary["failed_clips"] == 1
+    assert summary["workers"] == workers
+    assert [json.loads(s)["clip_id"] for s in output.read_text().splitlines()] == [0, 2, 3]
