+def _parallel_generations(jobs, *, workers):
+    """Bound remote calls while retaining manifest order and per-clip failures.
+
+    Inputs are resolved before workers start. Only independent clip generation
+    and its persistence run concurrently; final manifests/counters stay on the
+    caller thread. Default workers=1 uses the unchanged serial path above.
+    SQL pools must have at least ``workers`` connections.
+    """
+    ids = [str(job["video_raw_node"].node_id).replace("-", "").lower()
+           for _, _, job in jobs]
+    if len(ids) != len(set(ids)):
+        raise ValueError("parallel episodic jobs must target distinct raw nodes")
+
+    def invoke(item):
+        video_id, clip_id, job = item
+        try:
+            result, retries = _generate_with_retry(**job)
+            return video_id, clip_id, result, retries, None
+        except Exception as exc:
+            return video_id, clip_id, None, 0, exc
+
+    with ThreadPoolExecutor(max_workers=workers, thread_name_prefix="m3-episodic") as executor:
+        yield from executor.map(invoke, jobs)
+
+
